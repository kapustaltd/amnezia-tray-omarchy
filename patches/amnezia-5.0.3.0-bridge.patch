diff --git i/client/amneziaApplication.cpp w/client/amneziaApplication.cpp
index 3800840..fd89182 100644
--- i/client/amneziaApplication.cpp
+++ w/client/amneziaApplication.cpp
@@ -1,4 +1,7 @@
 #include "amneziaApplication.h"
+#ifdef AMNEZIA_OMARCHY_BRIDGE
+#include "omarchy/traybridge.h"
+#endif
 
 #include <QClipboard>
 #include <QFontDatabase>
@@ -179,6 +182,43 @@ void AmneziaApplication::init()
 
     m_coreController->setQmlRoot();
 
+#ifdef AMNEZIA_OMARCHY_BRIDGE
+    if (qEnvironmentVariable("AMNEZIA_TRAY_BRIDGE") != "0") {
+        auto navigate = [this](const QString &name) {
+            auto *page = m_coreController->pageController();
+            const QHash<QString, PageLoader::PageEnum> pages {
+                {"home", PageLoader::PageEnum::PageHome},
+                {"settings", PageLoader::PageEnum::PageSettings},
+                {"dns", PageLoader::PageEnum::PageSettingsDns},
+                {"killSwitch", PageLoader::PageEnum::PageSettingsKillSwitch},
+                {"split", PageLoader::PageEnum::PageSettingsSplitTunneling},
+                {"appSplit", PageLoader::PageEnum::PageSettingsAppSplitTunneling},
+                {"share", PageLoader::PageEnum::PageShare},
+                {"selfhost", PageLoader::PageEnum::PageSetupWizardCredentials},
+                {"importPreview", PageLoader::PageEnum::PageSetupWizardViewConfig},
+                {"protocols", PageLoader::PageEnum::PageSettingsServerProtocols}
+            };
+            if (!pages.contains(name)) return false;
+            if (name == "protocols") {
+                auto *servers = m_engine->rootContext()->contextProperty("ServersUiController").value<QObject *>();
+                const QString id = servers->property("defaultServerId").toString();
+                if (id.isEmpty()) return false;
+                QMetaObject::invokeMethod(servers, "setProcessedServerId", Q_ARG(QString, id));
+            }
+            emit page->raiseMainWindow();
+            if (name == "home") emit page->goToPageHome();
+            else if (name == "settings") emit page->goToPageSettings();
+            else emit page->goToPage(pages.value(name));
+            return true;
+        };
+        auto *bridge = new TrayBridge(m_engine->rootContext(), navigate, this);
+        connect(m_vpnConnection.get(), &VpnConnection::bytesChanged, bridge, &TrayBridge::addTraffic);
+        auto *controller = m_engine->rootContext()->contextProperty("ConnectionController").value<QObject *>();
+        connect(controller, SIGNAL(omarchyUserDisconnected()), bridge, SLOT(cancelResume()));
+        if (!bridge->start()) qWarning() << "Could not start the Omarchy session-bus API";
+    }
+#endif
+
 #if CLIENT_ENABLE_APP_UPDATES
     m_coreController->checkForAppUpdates();
 #endif
